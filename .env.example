# Copy this file to .env and fill in your real values.
# Expo only exposes variables prefixed with EXPO_PUBLIC_ to the app bundle.

# Base URL of your backend API (see services/api.ts)
EXPO_PUBLIC_API_BASE_URL=https://api.josanlogistics.com/v1

# Optional: override request timeout (ms)
EXPO_PUBLIC_API_TIMEOUT_MS=15000

# Optional: enable verbose request/response logging in dev
EXPO_PUBLIC_API_DEBUG=true
