# Josan Driver App — Local Development Environment
# Copy this to .env (git-ignored) and set your actual values.

# Backend API base URL (include /v1 suffix)
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1

# Increase timeout for slow development networks
EXPO_PUBLIC_API_TIMEOUT_MS=15000

# Set to "true" to log all API requests in Metro console
EXPO_PUBLIC_API_DEBUG=false

# Google Maps API Key (Android) — leave as placeholder for Expo Go dev
# Required for production builds. Get from: https://console.cloud.google.com/
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR_ANDROID_GOOGLE_MAPS_API_KEY
